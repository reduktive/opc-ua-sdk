PLACEHOLDER_ENCODE_BODY_BEGIN
PLACEHOLDER_BASE_CLASS_NAME::encode(limit, encoder);

if (auto uaBinary = encoder.get_ua_binary())
{
  detail::PLACEHOLDER_CLASS_NAME::encode(limit, *this, *uaBinary);
}
else if (auto xml = encoder.get_xml())
{
  detail::PLACEHOLDER_CLASS_NAME::encode(limit, *this, *xml);
}
PLACEHOLDER_ENCODE_BODY_END

PLACEHOLDER_ENCODE_EMPTY_BODY_BEGIN
PLACEHOLDER_BASE_CLASS_NAME::encode(limit, encoder);
PLACEHOLDER_ENCODE_EMPTY_BODY_END

PLACEHOLDER_ENCODE_ID_BODY_BEGIN
if (auto uaBinary = encoder.get_ua_binary())
{
  detail::PLACEHOLDER_CLASS_NAME::encode_id(limit, ns, *uaBinary);
}
else if (auto xml = encoder.get_xml())
{
  detail::PLACEHOLDER_CLASS_NAME::encode_id(limit, ns, *xml);
}
PLACEHOLDER_ENCODE_ID_BODY_END

PLACEHOLDER_ENCODE_ID_EMPTY_BODY_BEGIN
UA_UNUSED(limit);
UA_UNUSED(ns);
UA_UNUSED(encoder);
PLACEHOLDER_ENCODE_ID_EMPTY_BODY_END

PLACEHOLDER_DECODE_BODY_BEGIN
PLACEHOLDER_BASE_CLASS_NAME::decode(limit, decoder);

if (auto uaBinary = decoder.get_ua_binary())
{
  detail::PLACEHOLDER_CLASS_NAME::decode(limit, *uaBinary, *this);
}
else if (auto xml = decoder.get_xml())
{
  detail::PLACEHOLDER_CLASS_NAME::decode(limit, *xml, *this);
}
PLACEHOLDER_DECODE_BODY_END

PLACEHOLDER_DECODE_EMPTY_BODY_BEGIN
PLACEHOLDER_BASE_CLASS_NAME::decode(limit, decoder);
PLACEHOLDER_DECODE_EMPTY_BODY_END

PLACEHOLDER_REGISTER_DECLARATION_BEGIN
  /// Registers this type's decode factories so encoded values can be
  /// reconstructed by their encoding id.
  /// @param ns              Namespace context the encoding ids are registered under.
  /// @param uaBinaryFactory Binary-codec factory to register with, or null to skip.
  /// @param xmlFactory      XML-codec factory to register with, or null to skip.
static void register_type(const CodecNamespaceContext& ns,
  StructureFactory* uaBinaryFactory, StructureFactory* xmlFactory);
PLACEHOLDER_REGISTER_DECLARATION_END

PLACEHOLDER_REGISTER_DEFINITION_BEGIN
void PLACEHOLDER_CLASS_NAME::register_type(const CodecNamespaceContext& ns,
  StructureFactory* uaBinaryFactory, StructureFactory* xmlFactory)
{
PLACEHOLDER_REGISTER_NS_UNUSED
  if (uaBinaryFactory)
  {
    uaBinaryFactory->register_type(
      PLACEHOLDER_REGISTER_BIN_ID, detail::PLACEHOLDER_CLASS_NAME::create);
  }
  if (xmlFactory)
  {
    xmlFactory->register_type(PLACEHOLDER_REGISTER_XML_ID, detail::PLACEHOLDER_CLASS_NAME::create);
  }
}
PLACEHOLDER_REGISTER_DEFINITION_END

