bool PLACEHOLDER_CLASS_NAME::is_of_type(const CodecNamespaceContext& ns, const NodeId& dataTypeId) const
{
  NodeId myTypeId{ns.getNamespaceIndex(typeNamespaceUri), utils::to_underlying(typeId)};
  if (dataTypeId == myTypeId)
  {
    return true;
  }

  return PLACEHOLDER_BASE_CLASS_NAME::is_of_type(ns, dataTypeId);
}

NodeId PLACEHOLDER_CLASS_NAME::type_id(const CodecNamespaceContext& ns) const
{
  return NodeId{ns.getNamespaceIndex(typeNamespaceUri), utils::to_underlying(typeId)};
}

ExpandedNodeId PLACEHOLDER_CLASS_NAME::type_id() const
{
  return ExpandedNodeId{NodeId{0, utils::to_underlying(typeId)}, typeNamespaceUri};
}

String PLACEHOLDER_CLASS_NAME::type_name() const
{
  return typeName;
}

