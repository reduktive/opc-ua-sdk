#ifndef PLACEHOLDER_HEADER_GUARD
#define PLACEHOLDER_HEADER_GUARD

#include "ua_base_object.h"
#include "ua_node_accessor.h"
#include "ua_property.h"
PLACEHOLDER_SPEC_INCLUDES

PLACEHOLDER_NS_OPEN

PLACEHOLDER_METHOD_CALL_CONTEXT_FWD

class PLACEHOLDER_CLASS_NAME;
using PLACEHOLDER_CLASS_NAMEResult = PLACEHOLDER_CORE_QUALResult<PLACEHOLDER_CLASS_NAME>;

PLACEHOLDER_DOC
class PLACEHOLDER_CLASS_NAME : public BaseObject
{
public:
  /// Constructs an empty `PLACEHOLDER_CLASS_NAME` handle that references no node.
  PLACEHOLDER_CLASS_NAME() = default;

PLACEHOLDER_METHOD_ARGUMENT_STRUCTS
  /// Completion callback for create_async: receives the created `PLACEHOLDER_CLASS_NAME` handle, or an
  /// @ref ErrorDetail on failure.
  using CreateCompleteCallback = std::function<void(PLACEHOLDER_CLASS_NAMEResult)>;
  /// Completion callback for attach_async: receives the attached `PLACEHOLDER_CLASS_NAME` handle, or an
  /// @ref ErrorDetail on failure.
  using AttachCompleteCallback = std::function<void(PLACEHOLDER_CLASS_NAMEResult)>;

  /// Creates a new `PLACEHOLDER_TYPE_NAME` instance under `parent`.
  ///
  /// Instantiates the type's full child tree and completes asynchronously. The
  /// callback runs on an unspecified worker thread - do not block it.  ///
  /// **The returned handle OWNS the node it creates.** Destroying it removes that node and its
  /// subtree from the address space. Call `release()` to keep the node as permanent server
  /// content, or `remove_async()` to delete it eagerly. A handle obtained through `attach_*`
  /// owns nothing and only references the node.
  /// @param addressSpace Address space the instance is created in.
  /// @param parent       Parent node the new instance is organized under.
  /// @param browseName   Browse name for the new instance.
  /// @param options      Instantiation options (target namespace, node-id allocation, ...).
  /// @param complete     Receives the outcome: on success a `PLACEHOLDER_CLASS_NAME` handle,
  ///                     on failure an @ref ErrorDetail. This overload never throws.
  /// @see try_create_sync, create_sync
  static void create_async(AddressSpace addressSpace, const NodeId& parent,
    const QualifiedName& browseName, const InstantiationOptions& options, CreateCompleteCallback complete) noexcept;

  /// Creates a new `PLACEHOLDER_TYPE_NAME` instance under `parent`, blocking until complete.  ///
  /// **The returned handle OWNS the node it creates.** Destroying it removes that node and its
  /// subtree from the address space. Call `release()` to keep the node as permanent server
  /// content, or `remove_async()` to delete it eagerly. A handle obtained through `attach_*`
  /// owns nothing and only references the node.
  /// @param addressSpace Address space the instance is created in.
  /// @param parent       Parent node the new instance is organized under.
  /// @param browseName   Browse name for the new instance.
  /// @param options      Instantiation options (target namespace, node-id allocation, ...).
  /// @return The new handle, or an @ref ErrorDetail on failure. Never throws.
  /// @see create_async
  static PLACEHOLDER_CLASS_NAMEResult try_create_sync(AddressSpace addressSpace, const NodeId& parent,
    const QualifiedName& browseName, const InstantiationOptions& options) noexcept;

  /// Creates a new `PLACEHOLDER_TYPE_NAME` instance under `parent`, blocking until complete.  ///
  /// **The returned handle OWNS the node it creates.** Destroying it removes that node and its
  /// subtree from the address space. Call `release()` to keep the node as permanent server
  /// content, or `remove_async()` to delete it eagerly. A handle obtained through `attach_*`
  /// owns nothing and only references the node.
  /// @param addressSpace Address space the instance is created in.
  /// @param parent       Parent node the new instance is organized under.
  /// @param browseName   Browse name for the new instance.
  /// @param options      Instantiation options (target namespace, node-id allocation, ...).
  /// @return The new `PLACEHOLDER_CLASS_NAME` handle. A Good subcode is not returned; @ref try_create_sync
  ///         returns it.
  /// @throws UaException when the instantiation is not Good, an Uncertain answer included.
  /// @see create_async
  static PLACEHOLDER_CLASS_NAME create_sync(AddressSpace addressSpace, const NodeId& parent,
    const QualifiedName& browseName, const InstantiationOptions& options);

  /// Wraps an existing node as a `PLACEHOLDER_TYPE_NAME` handle, without taking ownership.
  ///
  /// The handle does no RAII cleanup; destroying it leaves the node in place.
  /// Completes asynchronously; the callback runs on an unspecified worker thread.
  /// @param addressSpace    Address space the node lives in.
  /// @param existingInstance Node id of the existing instance to wrap.
  /// @param complete        Receives the outcome: on success a `PLACEHOLDER_CLASS_NAME` handle,
  ///                        on failure an @ref ErrorDetail. This overload never throws.
  /// @see try_attach_sync, attach_sync
  static void attach_async(
    AddressSpace addressSpace, const NodeId& existingInstance, AttachCompleteCallback complete) noexcept;

  /// Wraps an existing node as a `PLACEHOLDER_TYPE_NAME` handle, blocking until complete.
  /// @param addressSpace     Address space the node lives in.
  /// @param existingInstance Node id of the existing instance to wrap.
  /// @return The handle, or an @ref ErrorDetail on failure. Never throws.
  /// @see attach_async
  static PLACEHOLDER_CLASS_NAMEResult try_attach_sync(
    AddressSpace addressSpace, const NodeId& existingInstance) noexcept;

  /// Wraps an existing node as a `PLACEHOLDER_TYPE_NAME` handle, blocking until complete.
  /// @param addressSpace     Address space the node lives in.
  /// @param existingInstance Node id of the existing instance to wrap.
  /// @return The `PLACEHOLDER_CLASS_NAME` handle. A Good subcode is not returned; @ref try_attach_sync
  ///         returns it.
  /// @throws UaException when the answer is not Good, an Uncertain one included.
  /// @see attach_async
  static PLACEHOLDER_CLASS_NAME attach_sync(
    AddressSpace addressSpace, const NodeId& existingInstance);

PLACEHOLDER_METHOD_ACCESSOR_DECLARATIONS
PLACEHOLDER_PROPERTY_ACCESSOR_DECLARATIONS
PLACEHOLDER_TYPED_READ_DECLARATIONS
PLACEHOLDER_TYPED_WRITE_DECLARATIONS
PLACEHOLDER_METHOD_HANDLER_DECLARATIONS
PLACEHOLDER_CHILD_OBJECT_DECLARATIONS
private:
  explicit PLACEHOLDER_CLASS_NAME(AddressSpace addressSpace, NodeId nodeId, optional<NodeSubtree> owned);

  static void create_impl_async(AddressSpace addressSpace, NodeId parent, QualifiedName browseName,
    InstantiationOptions options, CreateCompleteCallback complete) noexcept;

  static void attach_impl_async(
    AddressSpace addressSpace, NodeId existingInstance, AttachCompleteCallback complete) noexcept;

  // Common helper: finds a child property by browse name and attaches a Property handle.
  void find_property_async(QualifiedName browseName,
    std::function<void(PropertyResult)> complete) const noexcept;
};

PLACEHOLDER_NS_CLOSE

#endif  // PLACEHOLDER_HEADER_GUARD
