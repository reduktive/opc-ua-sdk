@PACKAGE_INIT@

# Full SemVer release identifier. The generated ConfigVersion file uses the
# numeric CMake project core because CMake has no prerelease-version model.
set(uasdk_RELEASE_VERSION "@UASDK_RELEASE_VERSION@")

# Package config for the reduktive OPC UA SDK.
#
# Consume with:
#   find_package(uasdk CONFIG REQUIRED)
#   target_link_libraries(my_app PRIVATE uasdk::uasdk)   # whole SDK
# or link a specific role lib (uasdk::core / uasdk::address-space /
# uasdk::client / uasdk::server / uasdk::app).
#
# Optional Historical Access component:
#   find_package(uasdk CONFIG REQUIRED COMPONENTS history)        # plug-your-own-storage engine
#   find_package(uasdk CONFIG REQUIRED COMPONENTS sqlite-store)   # + the bundled SQLite store
#   target_link_libraries(my_app PRIVATE uasdk::history-sqlite)
#
# The SDK ships as static archives, so dependencies that are PRIVATE at build
# time still become link-interface requirements of the final consumer and must
# be resolvable here. find_dependency only *locates* already-installed packages
# (it never downloads); the consumer provides them via system packages, vcpkg,
# or Conan.

include(CMakeFindDependencyMacro)

find_dependency(fmt)
# json only: Boost.URL is not used by the SDK. 1.83 is the declared floor
# (sdk/CMakeLists.txt, README.md).
find_dependency(Boost 1.83 COMPONENTS json)
find_dependency(OpenSSL)

include("${CMAKE_CURRENT_LIST_DIR}/uasdkTargets.cmake")

# Optional Historical Access components: uasdk::history (agnostic engine) and uasdk::history-sqlite
# (bundled store). Loaded only when requested, after the core targets above (the history export
# references uasdk::server / uasdk::build-private from uasdkTargets). list(FIND) is used instead of
# IN_LIST so the config does not depend on the consumer's CMP0057 policy setting.
list(FIND uasdk_FIND_COMPONENTS "history" _uasdk_want_history)
list(FIND uasdk_FIND_COMPONENTS "sqlite-store" _uasdk_want_sqlite_store)
if (_uasdk_want_history GREATER -1 OR _uasdk_want_sqlite_store GREATER -1)
    if (_uasdk_want_sqlite_store GREATER -1)
        # uasdk::history-sqlite links SQLite3::SQLite3 (PRIVATE -> a static-link requirement), and the
        # exported target carries that name as $<LINK_ONLY:SQLite3::SQLite3>. FindSQLite3 only defines
        # it from CMake 4.3 onward, so a consumer on an older CMake needs the same alias the SDK applies
        # at build time - without it the link fails on an unresolved imported target.
        find_dependency(SQLite3)
        if (NOT TARGET SQLite3::SQLite3)  # CMake < 4.3
            add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
        endif ()
    endif ()
    if (EXISTS "${CMAKE_CURRENT_LIST_DIR}/uasdkHistoryTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/uasdkHistoryTargets.cmake")
        set(uasdk_history_FOUND TRUE)
        set(uasdk_sqlite-store_FOUND TRUE)
    endif ()
endif ()
unset(_uasdk_want_history)
unset(_uasdk_want_sqlite_store)

check_required_components(uasdk)
