<?xml version="1.0" encoding="utf-8"?>
<!--
  A deliberately small information model for examples/server/nodeset_and_methods.

  It declares one Pump object directly beneath Objects, with a writable Speed variable and a Stop
  method. The file is the authority for the model's shape; the application supplies only the
  runtime behaviour after importing it.
-->
<UANodeSet xmlns="http://opcfoundation.org/UA/2011/03/UANodeSet.xsd"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:uax="http://opcfoundation.org/UA/2008/02/Types.xsd"
           LastModified="2026-08-31T00:00:00Z">
    <NamespaceUris>
        <Uri>urn:reduktive:opcua-sdk:example:pump</Uri>
    </NamespaceUris>
    <Models>
        <Model ModelUri="urn:reduktive:opcua-sdk:example:pump"
               Version="1.0.0"
               PublicationDate="2026-08-31T00:00:00Z">
            <RequiredModel ModelUri="http://opcfoundation.org/UA/"
                           Version="1.05.06"
                           PublicationDate="2025-11-08T00:00:00Z" />
        </Model>
    </Models>
    <Aliases>
        <Alias Alias="Double">i=11</Alias>
        <Alias Alias="HasTypeDefinition">i=40</Alias>
        <Alias Alias="HasComponent">i=47</Alias>
        <Alias Alias="Organizes">i=35</Alias>
    </Aliases>

    <UAObject NodeId="ns=1;i=5001" BrowseName="1:Pump" ParentNodeId="i=85">
        <DisplayName>Pump</DisplayName>
        <Description>One pump, declared by the model rather than built in code.</Description>
        <References>
            <Reference ReferenceType="HasTypeDefinition">i=58</Reference>
            <Reference ReferenceType="Organizes" IsForward="false">i=85</Reference>
            <Reference ReferenceType="HasComponent">ns=1;i=5002</Reference>
            <Reference ReferenceType="HasComponent">ns=1;i=5003</Reference>
        </References>
    </UAObject>

    <UAVariable NodeId="ns=1;i=5002"
                BrowseName="1:Speed"
                ParentNodeId="ns=1;i=5001"
                DataType="Double"
                ValueRank="-1"
                AccessLevel="3"
                UserAccessLevel="3">
        <DisplayName>Speed</DisplayName>
        <Description>Pump speed in revolutions per minute. Readable and writable.</Description>
        <References>
            <Reference ReferenceType="HasTypeDefinition">i=63</Reference>
            <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=5001</Reference>
        </References>
    </UAVariable>

    <UAMethod NodeId="ns=1;i=5003"
              BrowseName="1:Stop"
              ParentNodeId="ns=1;i=5001"
              Executable="true"
              UserExecutable="true">
        <DisplayName>Stop</DisplayName>
        <Description>Sets Speed to zero. Takes no arguments and returns none.</Description>
        <References>
            <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=5001</Reference>
        </References>
    </UAMethod>
</UANodeSet>
