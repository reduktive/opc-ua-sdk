      <!-- Structure-based OptionSet field (encoded inline as Value+ValidBits) -->
      <Field Name="Interfaces" DataType="ns=1;i=1020" />

      <!-- Nested structure with arrays of custom types -->
      <Field Name="SensorData" DataType="ns=1;i=2006" />

      <!-- Array field -->
