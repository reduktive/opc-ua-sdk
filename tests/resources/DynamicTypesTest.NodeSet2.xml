<?xml version="1.0" encoding="utf-8"?>
<!--
  Test NodeSet for dynamic type integration tests.

  Namespace: urn:test:industrial-monitoring (ns=1)
  Depends on: OPC UA core (ns=0)

  Type family exercises every dynamic type component:
    - Plain structure (diverse built-in field types)
    - Concrete nested structures (2-level and 3-level inline encoding)
    - StructureWithOptionalFields (including optional nested structure field)
    - Union (multiple alternatives)
    - Structure containing a union field
    - Enum (DynamicEnumView)
    - UInteger-based OptionSet (DynamicOptionSetView)
    - Structure-based OptionSet (DynamicOptionSet, subtype of OptionSet i=12755)
    - Structure with enum and option set integer fields
    - Array fields of built-in types (valueRank=1)
    - Array fields of custom types (structure, enum) (valueRank=1)
    - Capstone type combining all of the above
-->
