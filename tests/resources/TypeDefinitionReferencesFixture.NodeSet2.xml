<?xml version="1.0" encoding="utf-8"?>
<UANodeSet xmlns="http://opcfoundation.org/UA/2011/03/UANodeSet.xsd"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:uax="http://opcfoundation.org/UA/2008/02/Types.xsd">
    <NamespaceUris>
        <Uri>urn:example:typedefs</Uri>
    </NamespaceUris>

    <!-- An ObjectType (type definition; imported under Scope::TypeDefinitionsOnly) that carries
         two outgoing references: HasProperty (i=46) to its property child, and HasSubtype (i=45)
         declaring BaseObjectType (i=58) as a parent. A reference_filter must be honoured in the
         TypeDefinitionsOnly scope: rejecting HasProperty must drop that reference, while the
         property child (a type child) is still imported. -->
    <UAObjectType NodeId="ns=1;i=6010" BrowseName="1:MyObjectType">
        <References>
            <Reference ReferenceType="i=45" IsForward="false">i=58</Reference>
            <Reference ReferenceType="i=46">ns=1;i=6011</Reference>
        </References>
    </UAObjectType>

    <UAVariable NodeId="ns=1;i=6011" BrowseName="1:MyProperty" ParentNodeId="ns=1;i=6010" DataType="i=17">
        <References>
            <Reference ReferenceType="i=46" IsForward="false">ns=1;i=6010</Reference>
            <Reference ReferenceType="i=40">i=68</Reference>
        </References>
    </UAVariable>
</UANodeSet>
